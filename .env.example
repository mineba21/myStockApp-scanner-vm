# ── Telegram ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Slack Incoming Webhook ─────────────────────────────────────
# Keep this URL secret. It posts only to the channel selected in Slack.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME

# ── Sites API authentication ───────────────────────────────────
# Generate a long random value. Store the same value as a Sites server secret.
SITES_API_KEY=replace_with_a_long_random_value

# ── Core Scan ───────────────────────────────────────────────────
SCAN_LOOKBACK_DAYS=7
MA_PERIOD=150
MA_SLOPE_PERIOD=10
VOLUME_AVG_PERIOD=20

# ── BREAKOUT (돌파) ─────────────────────────────────────────────
BREAKOUT_BASE_LOOKBACK_DAYS=60
BREAKOUT_MIN_BASE_DAYS=15
BREAKOUT_VOLUME_RATIO=1.5
# Step 2 — legacy v3(_find_breakout_signal)와 v4(detect_stage2_breakout)가
# 공유. 15.0 → 25.0 (실측: MRK 28%, SJM 23.7% 등 정상 돌파가 과열로 잘림).
BREAKOUT_MAX_EXTENDED_PCT=25.0
REQUIRE_PRICE_ABOVE_MA50=true

# ── RE_BREAKOUT (재돌파) ────────────────────────────────────────
REBREAKOUT_BASE_LOOKBACK_DAYS=30
REBREAKOUT_MAX_PULLBACK_PCT=15.0
REBREAKOUT_VOLUME_RATIO=1.5
REBREAKOUT_REQUIRE_VOLUME_DRYUP=false

# ── REBOUND (눌림목 반등) ───────────────────────────────────────
REBOUND_MA_PERIOD=50
REBOUND_TOUCH_PCT=3.0
REBOUND_CONFIRM_PCT=2.0
REBOUND_MAX_PULLBACK_PCT=12.0
REBOUND_REQUIRE_VOLUME_DRYUP=false
REBOUND_ALLOW_PIVOT_RETEST=true

# ── Market Filter ────────────────────────────────────────────────
ENABLE_MARKET_FILTER=true
BLOCK_NEW_BUYS_IN_BEAR=true
CAUTION_MODE=allow_with_flag

# ── v4 Weekly Weinstein (원전 충실) ─────────────────────────────
# 주봉 30-SMA 기반 Stage 판정 (Weinstein 원전 기준)
WEEKLY_MA_LONG=30
WEEKLY_MA_SHORT=10
DAILY_MA_FAST=50
DAILY_MA_SLOW=150
# Step 2 — 주봉 게이트는 "확실히 거래량 없는 종목만 조기 제외"하는 성능
# 컷으로 재정의 (Step 1 A/B 실측: 게이트를 없애도 실제 통과 종목이 늘지
# 않음 — 병목은 base 정의였음). 2.0 → 0.5.
BREAKOUT_WEEKLY_VOL_RATIO=0.5
# Step 2 — 실효 breakout 거래량 비율이 실측상 1.54x 부근(Weinstein 원전
# 수준)이라 3.0 은 과했음. 1.5 로 완화.
BREAKOUT_DAILY_VOL_RATIO=1.5
# Mansfield RS (0선 기준 절대 강도)
RS_LOOKBACK_WEEKS=52
BASE_MIN_WEEKS=5
PIVOT_LOOKBACK_WEEKS=26

# ── Step 2 — 2단(2-tier) Base 구조 (BASE_MODE=v2) ───────────────
# v1(단일 확장 루프)은 base 가 길수록 pivot/손절폭도 함께 벌어졌다(S&P500
# 실측: 돌파 34건, 평균 손절폭 14.5%). v2는 자격 구간(폭만 확인)과 tight
# 구간(pivot/손절 기준)을 분리해 손절폭을 8.3% 수준으로 좁힌다(돌파 82건).
BASE_MODE=v2
BASE_LOOKBACK_DAYS=25
BASE_MAX_WIDTH_PCT=25.0
US_BASE_MAX_WIDTH_PCT=25.0
KR_BASE_MAX_WIDTH_PCT=30.0
TIGHT_LOOKBACK_DAYS=10
TIGHT_MAX_WIDTH_PCT=10.0
US_TIGHT_MAX_WIDTH_PCT=10.0
KR_TIGHT_MAX_WIDTH_PCT=12.0
TIGHT_CONTRACTION_RATIO=0.85

# ── Step 4 — 진입 시점 통제 (기본은 모두 shadow 경고) ──────────
MAX_PIVOT_EXT_PCT=5.0
PIVOT_EXT_AS_GATE=false
UPTHRUST_CHECK_DAYS=3
UPTHRUST_AS_GATE=false
UPTHRUST_COOLDOWN_DAYS=10
ALERT_MAX_CUR_EXT_PCT=5.0
ALERT_MAX_CUR_STOP_PCT=12.0
ALERT_FRESHNESS_AS_GATE=false

# ── Step 5 — 포지션 사이징 (KR_/US_ 접두사로 시장별 override 가능) ─
RISK_PCT=1.0
MAX_POSITION_PCT=20.0
MAX_TOTAL_HEAT_PCT=6.0
MIN_R_PCT=3.0
MAX_R_PCT=15.0
R_BAND_AS_GATE=true

# ── Step 6 — 보유 종목 매도 알림 중복 억제 ────────────────────
HOLDING_ALERT_REPEAT_HOURS=24

# ── Universe ────────────────────────────────────────────────────
US_UNIVERSE=sp500+nasdaq100

# ── VAA · LAA · 듀얼 모멘텀 독립 계산기 ─────────────────────
ASSET_ALLOCATION_DIR=/home/ubuntu/apps/asset-allocation
ASSET_ALLOCATION_CACHE_DIR=/home/ubuntu/apps/asset-allocation/cache
ASSET_ALLOCATION_TIMEOUT_SECONDS=120

# ── Schedule ────────────────────────────────────────────────────
# 각 시장의 정규장 종가 확정 후 실행. KR=KST, US=America/New_York(DST 자동).
KR_SCHEDULE_TIMES=16:10
US_SCHEDULE_TIMES=16:30

# ── Kiwoom REST API (조회 전용, 기본은 모의투자) ───────────────
KIWOOM_MODE=mock
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_TIMEOUT_SECONDS=15
# 다계좌 사용 시: ~/.config/mystockapp/kiwoom_profiles.json
KIWOOM_PROFILES_FILE=
KIWOOM_WEB_ENABLED=false
KIWOOM_BALANCE_CACHE_SECONDS=60

# ── DB ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
